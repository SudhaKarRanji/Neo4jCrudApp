<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <add key="Neo4jUri" value="neo4j://localhost:7687" />
    <add key="Neo4jUser" value="neo4j" />
    <add key="Neo4jPassword" value="qwertypop" />
    <add key="Neo4jDatabase" value="demo" />
  </appSettings>
</configuration>
